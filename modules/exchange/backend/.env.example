# Copy to .env and adjust. Every value is optional - the API falls back to a
# seeded in-memory store when DATABASE_URL is missing, so it runs with zero setup.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string used by src/db/pgStore.js
# DATABASE_URL=postgres://postgres:password@localhost:5432/skillmarket

# Secret used to verify Bearer JWTs issued by the SkillMarket auth service.
JWT_SECRET=change-me-in-production

# Comma-separated list of allowed browser origins. Default allows all.
CORS_ORIGIN=*
